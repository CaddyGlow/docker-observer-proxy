# The host address on VLAN 100. Never bind the proxy to every interface.
DOP_LISTEN_ADDR=10.83.100.5:2375
DOP_DOCKER_SOCKET=/var/run/docker.sock
DOP_ALLOWED_CLIENT_IPS=10.83.100.10
DOP_ALLOWED_CONTAINERS=homepage,grafana,prometheus
DOP_AUTH_TOKEN_FILE=/etc/docker-observer-proxy.token
DOP_TIMEOUT_SECONDS=5
DOP_MAX_RESPONSE_BYTES=8388608
DOP_LOG_FORMAT=json
RUST_LOG=docker_observer_proxy=info
